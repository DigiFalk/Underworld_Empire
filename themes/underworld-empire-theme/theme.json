{
	"$schema": "https://schemas.wp.org/wp/6.1/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "base", "name": "Background", "color": "#121417" },
				{ "slug": "surface", "name": "Surface", "color": "#1b1e23" },
				{ "slug": "surface-2", "name": "Surface 2", "color": "#23272e" },
				{ "slug": "border", "name": "Border", "color": "#2f343c" },
				{ "slug": "contrast", "name": "Text", "color": "#e6e3dc" },
				{ "slug": "muted", "name": "Muted text", "color": "#9a978f" },
				{ "slug": "heading", "name": "Headings", "color": "#f2efe8" },
				{ "slug": "accent", "name": "Accent", "color": "#c9a24a" },
				{ "slug": "button", "name": "Button", "color": "#c9a24a" },
				{ "slug": "button-text", "name": "Button text", "color": "#1a1405" }
			]
		},
		"typography": {
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "medium", "name": "Medium", "size": "1rem" },
				{ "slug": "large", "name": "Large", "size": "1.5rem" },
				{ "slug": "x-large", "name": "Extra large", "size": "2.25rem" }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		}
	}
}
